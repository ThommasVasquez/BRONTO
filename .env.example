# ==============================================================================
# BRONTO® | Variables de Entorno del Proyecto
# ==============================================================================

# URL Pública del Sitio (Utilizada para generación de Canonical URLs y Metadatos)
NEXT_PUBLIC_SITE_URL=https://bronto.com.co

# Identificación de Entorno
ENVIRONMENT=production

# Configuración Comercial Opcional (Si no se configuran, se usan los valores de siteConfig.ts)
NEXT_PUBLIC_WHATSAPP_NUMBER=573100000000
NEXT_PUBLIC_CONTACT_EMAIL=comercial@bronto.com.co
NEXT_PUBLIC_PHONE_NUMBER=+57 (601) 745-0000

# Cloudflare Workers / KV (Opcional para persistencia de cotizaciones)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
