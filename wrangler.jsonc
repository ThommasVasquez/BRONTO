{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bronto-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    // Prepared for future quote persistence or cache
    // { "binding": "BRONTO_CACHE", "id": "<kv-id-here>" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "NEXT_PUBLIC_SITE_URL": "https://bronto.com.co"
  }
}
